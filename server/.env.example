# ─────────────────────────────────────────────────────────────────────
#  REQUIRED .env SECRETS — Portfolio_2.0 Server
# ─────────────────────────────────────────────────────────────────────

# ── Core ──────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB Atlas ──────────────────────────────────────────────────────
# Get from: https://cloud.mongodb.com → your cluster → Connect → Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/mydb?retryWrites=true&w=majority

# ── JWT Auth ───────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<64-char-random-hex>

# ── Azure Blob Storage ─────────────────────────────────────────────────
# Get from: portal.azure.com → Storage Account → Access Keys → Connection string
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
AZURE_BLOB_CONTAINER_NAME=notes   # container name for notes/files

# ── Cloudinary (image uploads) ─────────────────────────────────────────
# Get from: cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>

# ── GitHub (repo import, GraphQL API) ─────────────────────────────────
# Create at: github.com/settings/tokens → Fine-grained token
# Scopes needed: repo (read), metadata (read)
GITHUB_TOKEN=ghp_<your-token>

# ── OpenRouter AI ─────────────────────────────────────────────────────
# Get from: openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-<your-key>

# ── Qdrant Vector DB ───────────────────────────────────────────────────
# Get from: cloud.qdrant.io → cluster → API Keys
QDRANT_URL=https://<cluster-id>.<region>.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=<your-qdrant-key>
QDRANT_COLLECTION_NAME=Portfolio

# ── EC2 Terminal (NEW) ─────────────────────────────────────────────────
# Auto-generated once — keep this secret, never commit it
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EC2_SESSION_SECRET=<64-char-hex>

# ── AWS EC2 SSH Connection ──────────────────────────────────────────────
# Your AWS EC2 instance details for quick-connect feature
AWS_EC2_DEFAULT_HOST=<your-ec2-public-ip-or-hostname>
AWS_EC2_DEFAULT_USERNAME=ec2-user  # or ubuntu, admin depending on your AMI

# Optional: Use SSH private key instead of password (more secure)
# AWS_EC2_PRIVATE_KEY=<your-pem-file-content>  # Paste your .pem key content here

# NOTE: EC2 HOST / USERNAME / PASSWORD are entered by the USER at runtime
# in the browser Terminal UI — they are NEVER stored in .env or the database.
# They are AES-256-GCM encrypted in memory for 60 seconds, then discarded.
